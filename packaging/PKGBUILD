# Maintainer: RaineDev <mrfenixvd@gmail.com>
pkgname=orbita
pkgver=0.1.0
pkgrel=1
pkgdesc="Клиент Яндекс.Диска для Linux"
arch=('x86_64')
url="https://github.com/fenixvd/Orbita"
license=('GPL-2.0-only')
depends=(
    'qt6-base'
    'qt6-declarative'
    'kirigami'
    'kio'
    'kstatusnotifieritem'
    'qqc2-desktop-style'   # стиль org.kde.desktop, иначе окно выглядит чужим
    'fuse3'
    'sqlite'
)
makedepends=('cmake' 'ninja' 'extra-cmake-modules')
# Архив GitHub распаковывается в каталог с именем репозитория — Orbita,
# с большой буквы, а не $pkgname.
_repo=Orbita
source=("$pkgname-$pkgver.tar.gz::https://github.com/fenixvd/$_repo/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$_repo-$pkgver"
    # Префикс именно /usr: в /usr/local плагины Dolphin не ищутся.
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    cd "$srcdir/$_repo-$pkgver"
    ctest --test-dir build --output-on-failure
}

package() {
    cd "$srcdir/$_repo-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
}
